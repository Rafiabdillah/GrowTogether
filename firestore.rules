rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function couplePath(coupleId) {
      return /databases/$(database)/documents/couples/$(coupleId);
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function coupleData(coupleId) {
      return get(couplePath(coupleId)).data;
    }

    function userData(userId) {
      return get(userPath(userId)).data;
    }

    function isCoupleMember(coupleId) {
      return coupleId is string
        && coupleId.size() > 0
        && exists(couplePath(coupleId))
        && (coupleData(coupleId).user1Id == request.auth.uid
            || coupleData(coupleId).user2Id == request.auth.uid);
    }

    function isOpenCouple(coupleId) {
      return coupleId is string
        && coupleId.size() > 0
        && exists(couplePath(coupleId))
        && (!('user2Id' in coupleData(coupleId))
            || coupleData(coupleId).user2Id == ''
            || coupleData(coupleId).user2Id == null);
    }

    function sharesCouple(userId) {
      return exists(userPath(userId))
        && 'coupleId' in userData(userId)
        && isCoupleMember(userData(userId).coupleId);
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }

    // Users: self read/write plus partner profile when sharing a couple room.
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId)
        && (request.auth.uid == userId || sharesCouple(userId));
      allow list: if false;
      allow create: if isSignedIn() && isValidId(userId)
        && request.auth.uid == userId
        && incoming().id == userId;
      allow update: if isSignedIn() && isValidId(userId)
        && request.auth.uid == userId;
      allow delete: if isSignedIn() && isValidId(userId)
        && request.auth.uid == userId;
    }

    // Couples: readable by members, and by joiners while user2 slot is open.
    match /couples/{coupleId} {
      allow get: if isSignedIn() && isValidId(coupleId)
        && (isCoupleMember(coupleId) || isOpenCouple(coupleId));
      allow list: if isSignedIn()
        && (resource.data.user1Id == request.auth.uid
            || resource.data.user2Id == request.auth.uid);
      allow create: if isSignedIn() && isValidId(coupleId)
        && incoming().user1Id == request.auth.uid
        && (!('user2Id' in incoming())
            || incoming().user2Id == ''
            || incoming().user2Id == null);
      allow update: if isSignedIn() && isValidId(coupleId)
        && (
          (isCoupleMember(coupleId)
            && incoming().user1Id == existing().user1Id
            && incoming().user2Id == existing().user2Id)
          ||
          (isOpenCouple(coupleId)
            && incoming().user1Id == existing().user1Id
            && incoming().user2Id == request.auth.uid)
          ||
          // A member removing their own slot (leaving without ending the room).
          (existing().user2Id == request.auth.uid
            && incoming().user1Id == existing().user1Id
            && incoming().user2Id == '')
          ||
          // The owner leaving hands the room over to the remaining partner.
          (existing().user1Id == request.auth.uid
            && existing().user2Id != null
            && existing().user2Id != ''
            && incoming().user1Id == existing().user2Id
            && incoming().user2Id == '')
        );
      allow delete: if isSignedIn() && isValidId(coupleId) && isCoupleMember(coupleId);
    }

    // Invite codes are unguessable pointers to an open room. No enumeration.
    match /inviteCodes/{code} {
      allow get: if isSignedIn() && code.matches('^[A-Z0-9]{4,12}$');
      allow list: if false;
      allow create: if isSignedIn()
        && code.matches('^[A-Z0-9]{4,12}$')
        && incoming().userId == request.auth.uid
        && exists(userPath(request.auth.uid))
        && userData(request.auth.uid).inviteCode == code
        && incoming().coupleId is string
        && isCoupleMember(incoming().coupleId);
      allow update: if isSignedIn()
        && code.matches('^[A-Z0-9]{4,12}$')
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && userData(request.auth.uid).inviteCode == code
        && incoming().coupleId is string
        && isCoupleMember(incoming().coupleId);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Habits: owners always see their own rows; the partner only sees non-private ones.
    match /habits/{habitId} {
      allow read: if isSignedIn() && isValidId(habitId)
        && 'coupleId' in existing()
        && (
          existing().ownerId == request.auth.uid
          || (isCoupleMember(existing().coupleId) && existing().isPrivate == false)
        );
      allow create: if isSignedIn()
        && incoming().ownerId == request.auth.uid
        && incoming().coupleId is string
        && isCoupleMember(incoming().coupleId);
      allow update: if isSignedIn()
        && isCoupleMember(existing().coupleId)
        && (existing().ownerId == request.auth.uid || existing().isShared == true)
        && incoming().coupleId == existing().coupleId
        && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn()
        && isCoupleMember(existing().coupleId)
        && existing().ownerId == request.auth.uid;
    }

    // Habit logs: each user always reads their own rows; the partner only reads
    // rows explicitly marked as couple-visible (private habit logs stay private).
    match /logs/{logId} {
      allow read: if isSignedIn() && isValidId(logId)
        && 'coupleId' in existing()
        && (
          existing().userId == request.auth.uid
          || (isCoupleMember(existing().coupleId) && existing().visibility == 'couple')
        );
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().coupleId is string
        && isCoupleMember(incoming().coupleId);
      allow update: if isSignedIn()
        && existing().userId == request.auth.uid
        && isCoupleMember(existing().coupleId)
        && incoming().coupleId == existing().coupleId;
      allow delete: if isSignedIn()
        && existing().userId == request.auth.uid
        && isCoupleMember(existing().coupleId);
    }

    // Focus sessions (sessions tied to a private habit only belong to their owner)
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && isValidId(sessionId)
        && 'coupleId' in existing()
        && (
          existing().userId == request.auth.uid
          || (isCoupleMember(existing().coupleId) && existing().visibility == 'couple')
        );
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().coupleId is string
        && isCoupleMember(incoming().coupleId);
      allow update, delete: if isSignedIn()
        && existing().userId == request.auth.uid
        && isCoupleMember(existing().coupleId);
    }

    // Shared reading list
    match /books/{bookId} {
      allow read: if isSignedIn() && isValidId(bookId)
        && 'coupleId' in existing()
        && isCoupleMember(existing().coupleId);
      allow create: if isSignedIn()
        && incoming().addedById == request.auth.uid
        && incoming().coupleId is string
        && isCoupleMember(incoming().coupleId);
      allow update: if isSignedIn()
        && isCoupleMember(existing().coupleId)
        && incoming().coupleId == existing().coupleId;
      allow delete: if isSignedIn()
        && existing().addedById == request.auth.uid
        && isCoupleMember(existing().coupleId);
    }

    // Weekly journals: authors always see their own; unshared entries stay private.
    match /journals/{journalId} {
      allow read: if isSignedIn() && isValidId(journalId)
        && 'coupleId' in existing()
        && (
          existing().authorId == request.auth.uid
          || (isCoupleMember(existing().coupleId) && existing().isShared == true)
        );
      allow create: if isSignedIn()
        && incoming().authorId == request.auth.uid
        && incoming().coupleId is string
        && isCoupleMember(incoming().coupleId);
      allow update, delete: if isSignedIn()
        && existing().authorId == request.auth.uid
        && isCoupleMember(existing().coupleId);
    }

    // Encouragement reactions
    match /reactions/{reactionId} {
      allow read: if isSignedIn() && isValidId(reactionId)
        && 'coupleId' in existing()
        && isCoupleMember(existing().coupleId);
      allow create: if isSignedIn()
        && incoming().senderId == request.auth.uid
        && incoming().coupleId is string
        && isCoupleMember(incoming().coupleId);
      allow update, delete: if isSignedIn()
        && isCoupleMember(existing().coupleId)
        && (existing().senderId == request.auth.uid
            || existing().receiverId == request.auth.uid);
    }

    // Agreements (Brankas Kesepakatan)
    match /agreements/{agreementId} {
      allow read: if isSignedIn() && isValidId(agreementId)
        && 'coupleId' in existing()
        && isCoupleMember(existing().coupleId);
      allow create: if isSignedIn()
        && incoming().creatorId == request.auth.uid
        && incoming().coupleId is string
        && isCoupleMember(incoming().coupleId);
      allow update: if isSignedIn()
        && isCoupleMember(existing().coupleId)
        && incoming().coupleId == existing().coupleId;
      allow delete: if isSignedIn()
        && existing().creatorId == request.auth.uid
        && isCoupleMember(existing().coupleId);
    }

    // Nightly check-ins: unshared check-ins stay private to their author.
    match /checkins/{checkinId} {
      allow read: if isSignedIn() && isValidId(checkinId)
        && 'coupleId' in existing()
        && (
          existing().userId == request.auth.uid
          || (isCoupleMember(existing().coupleId) && existing().isShared == true)
        );
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().coupleId is string
        && isCoupleMember(incoming().coupleId);
      allow update, delete: if isSignedIn()
        && existing().userId == request.auth.uid
        && isCoupleMember(existing().coupleId);
    }
  }
}
